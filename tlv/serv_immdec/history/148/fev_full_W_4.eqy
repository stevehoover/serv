############################################
# GOLDEN DESIGN
############################################
[gold]
read_verilog -sv -formal prepared.sv

############################################
# UPDATED / GATE DESIGN
############################################
[gate]
read_verilog -sv -formal wip_W_4.sv

[script]
chparam -set W 4
#prep -top serv_immdec -flatten
hierarchy -top serv_immdec -check
flatten
proc -ifx
#splitnets -ports
clean
setundef -anyseq
#sim -w -clock clk -reset reset -rstlen 10 -n 10


############################################
# MATCHING / PARTITIONING HINTS
############################################
# The below section should be formatted as:
# [match serv_immdec]
# gold-match <gold_signal> <gate_signal>
# ...
# And should be followed by a blank line, marking the end of the section.
# Gate names may use TL-Verilog pipesignal references, which will be mapped by `fev.sh`.
[match serv_immdec]
gold-match gen_immdec_w_eq_4.rs1_addr rs1_addr
gold-match gen_immdec_w_eq_4.rs2_addr rs2_addr
gold-match gen_immdec_w_eq_4.signbit signbit
gold-match gen_immdec_w_eq_4.i31 ii31
gold-match gen_immdec_w_eq_4.i30 ii30
gold-match gen_immdec_w_eq_4.i29 ii29
gold-match gen_immdec_w_eq_4.i28 ii28
gold-match gen_immdec_w_eq_4.i27 ii27
gold-match gen_immdec_w_eq_4.i26 ii26
gold-match gen_immdec_w_eq_4.i25 ii25
gold-match gen_immdec_w_eq_4.i24 |default<>0$ii24
gold-match gen_immdec_w_eq_4.i23 ii23
gold-match gen_immdec_w_eq_4.i22 ii22
gold-match gen_immdec_w_eq_4.i21 ii21
gold-match gen_immdec_w_eq_4.i20 ii20
gold-match gen_immdec_w_eq_4.i19 ii19
gold-match gen_immdec_w_eq_4.i18 ii18
gold-match gen_immdec_w_eq_4.i17 ii17
gold-match gen_immdec_w_eq_4.i16 |default<>0$ii16
gold-match gen_immdec_w_eq_4.i15 ii15
gold-match gen_immdec_w_eq_4.i14 ii14
gold-match gen_immdec_w_eq_4.i13 ii13
gold-match gen_immdec_w_eq_4.i12 |default<>0$ii12
gold-match gen_immdec_w_eq_4.i11 |default<>0$ii11
gold-match gen_immdec_w_eq_4.i10 ii10
gold-match gen_immdec_w_eq_4.i9 ii9
gold-match gen_immdec_w_eq_4.i8 ii8
gold-match gen_immdec_w_eq_4.i7 ii7
gold-match gen_immdec_w_eq_4.i7_2 ii7_b2
gold-match gen_immdec_w_eq_4.i20_2 ii20_b2
gold-match gen_immdec_w_eq_4.rd_addr rd_addr

[collect *]
# Let EQY partition automatically.
# If you want to force grouping by register name patterns, you can uncomment:
# group .*
group .*

[partition *]
# It can be useful to group outputs to avoid output cut points if outputs are used internally.
#name outputs ^o_.*


############################################
# STRATEGIES
############################################
# Disabled due to https://github.com/YosysHQ/eqy/issues/83
#[strategy fast_sat]
#use sat
#depth 10

[strategy sby_seq]
use sby
depth 20
engine smtbmc
