############################################
# GOLDEN DESIGN
############################################
[gold]
read_verilog -sv -formal prepared.sv

############################################
# UPDATED / GATE DESIGN
############################################
[gate]
read_verilog -sv -formal wip_W_1_SHARED_0.sv

[script]
chparam -set W 1 -set SHARED_RFADDR_IMM_REGS 0
#prep -top serv_immdec -flatten
hierarchy -top serv_immdec -check
flatten
proc -ifx
#splitnets -ports
clean
setundef -anyseq
#sim -w -clock clk -reset reset -rstlen 10 -n 10


############################################
# MATCHING / PARTITIONING HINTS
############################################
# The below section should be formatted as:
# [match serv_immdec]
# gold-match <gold_signal> <gate_signal>
# ...
# And should be followed by a blank line, marking the end of the section.
# Gate names may use TL-Verilog pipesignal references, which will be mapped by `fev.sh`.
[match serv_immdec]
gold-match gen_immdec_w_eq_1.imm31 DEFAULT_imm31_a0
gold-match gen_immdec_w_eq_1.imm19_12_20 DEFAULT_imm_b19_b12_b20_a0
gold-match gen_immdec_w_eq_1.imm7 DEFAULT_imm7_a0
gold-match gen_immdec_w_eq_1.imm30_25 DEFAULT_imm_b30_b25_a0
gold-match gen_immdec_w_eq_1.imm24_20 DEFAULT_imm_b24_b20_a0
gold-match gen_immdec_w_eq_1.imm11_7 DEFAULT_imm_b11_b7_a0
gold-match gen_immdec_w_eq_1.signbit DEFAULT_signbit_a0
gold-match gen_immdec_w_eq_1.gen_separate_imm_regs.rd_addr DEFAULT_rd_addr_w1_a0
gold-match gen_immdec_w_eq_1.gen_separate_imm_regs.rs1_addr DEFAULT_rs1_addr_w1_a0
gold-match gen_immdec_w_eq_1.gen_separate_imm_regs.rs2_addr DEFAULT_rs2_addr_w1_a0

[collect *]
# Let EQY partition automatically.
# If you want to force grouping by register name patterns, you can uncomment:
# group .*
#group .*

[partition *]
# It can be useful to group outputs to avoid output cut points if outputs are used internally.
name outputs /^o_.*/


############################################
# STRATEGIES
############################################
# Disabled due to https://github.com/YosysHQ/eqy/issues/83
#[strategy fast_sat]
#use sat
#depth 10

[strategy sby_seq]
use sby
depth 20
engine smtbmc
