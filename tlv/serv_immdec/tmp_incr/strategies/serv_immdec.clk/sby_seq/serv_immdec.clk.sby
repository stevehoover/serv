[options]
mode prove
depth 20
expect pass,fail,unknown,timeout


[engines]
smtbmc

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/serv_immdec.clk.sv
read_ilang ../../../../../partitions/serv_immdec.clk.il
hierarchy -top miter; proc

formalff -clk2ff -ff2anyinit gate.serv_immdec.clk
setundef -anyseq gate.serv_immdec.clk
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

