############################################
# GOLDEN DESIGN
############################################
[gold]
read_verilog -sv -formal prepared.sv

############################################
# UPDATED / GATE DESIGN
############################################
[gate]
read_verilog -sv -formal wip_WIDTH_2.sv

[script]
chparam -set width 2
#prep -top serv_rf_ram_if -flatten
hierarchy -top serv_rf_ram_if -check
flatten
proc -ifx
#splitnets -ports
clean
setundef -anyseq
#sim -w -clock clk -reset reset -rstlen 10 -n 10


############################################
# MATCHING / PARTITIONING HINTS
############################################
# The below section should be formatted as:
# [match serv_rf_ram_if]
# gold-match <gold_signal> <gate_signal>
# ...
# And should be followed by a blank line, marking the end of the section.
# Gate names may use TL-Verilog pipesignal references, which will be mapped by `fev.sh`.
[match serv_rf_ram_if]
gold-match rgnt |default<>0$rgnt
gold-match rtrig1 |default<>0$rtrig1
gold-match wen0_r |default<>0$wen0_r
gold-match wen1_r |default<>0$wen1_r
gold-match wdata0_r |default<>0$wdata0_r
gold-match wdata1_r |default<>0$wdata1_r
gold-match rgate |default<>0$rgate
gold-match rreq_r |default<>0$rreq_r
gold-match wtrig0 |default<>0$wtrig0
gold-match wtrig1 |default<>0$wtrig1
gold-match rtrig0 |default<>0$rtrig0
gold-match rdata0 |default<>0$rdata0
gold-match rdata1 |default<>0$rdata1
gold-match rcnt |default<>0$rcnt

[collect *]
# Try to prevent problematic partitioning of gen_wtrig_ratio_neq_2.wtrig0_r
# group .*

[partition *]
# It can be useful to group outputs to avoid output cut points if outputs are used internally.


############################################
# STRATEGIES
############################################
# Disabled due to https://github.com/YosysHQ/eqy/issues/83
#[strategy fast_sat]
#use sat
#depth 10

[strategy sby_seq]
use sby
depth 20
engine smtbmc